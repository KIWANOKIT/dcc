<?xml version="1.0" encoding="utf-8"?>
<!-- Secure transport only: plain http:// and ws:// are blocked by the OS itself. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
